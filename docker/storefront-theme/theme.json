{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"styles": {
		"css": "header.wp-block-template-part { position: sticky; top: var(--wp-admin--admin-bar--height, 0px); z-index: 100; background-color: var(--wp--preset--color--base); border-bottom: 1px solid var(--wp--preset--color--accent-6); }",
		"blocks": {
			"core/comment-author-name": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			},
			"core/navigation": {
				"css": "& .wp-block-navigation__submenu-container { white-space: nowrap; }",
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			},
			"core/post-date": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			},
			"core/post-title": {
				"css": "text-align: center;",
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			}
		},
		"elements": {
			"link": {
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":active": {
					"typography": {
						"textDecoration": "none"
					}
				}
			}
		}
	}
}
