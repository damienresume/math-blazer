# Template for your settings file. Copy it and fill in your own values:
#
#   cp .env.example .env
#
# This file holds generic placeholders and is safe to commit. The real values go in
# the .env file, which holds the settings of your own computer. Git ignores .env, so
# real passwords are never pushed. Replace every value that starts with "change-me"
# with a value that you choose.

# The port on your computer that opens the site, for example http://localhost:8080.
# Choose another port if 8080 is already in use.
WP_PORT=8080

# The site title and the WordPress administrator that docker/setup.sh creates.
WP_TITLE="Math Blazer"
WP_ADMIN_USER=change-me-admin-user
WP_ADMIN_PASSWORD=change-me-admin-password
WP_ADMIN_EMAIL=you@example.com

# The database settings. WordPress and MySQL both read them.
# Choose your own passwords. Use at least 12 characters and only letters, digits,
# hyphens and underscores. Characters such as $ and # break .env files.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me-database-password
DB_ROOT_PASSWORD=change-me-database-root-password

# The user id and group id that the build uses, so files in build/ belong to you.
# On Linux and in the Windows Ubuntu terminal, run `id -u` and `id -g` to find yours.
# Most computers use 1000 for both. On macOS leave 1000.
LOCAL_UID=1000
LOCAL_GID=1000
