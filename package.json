{
	"name": "math-blazer",
	"version": "0.1.0",
	"description": "Course curriculum accordion block for the storefront of an interactive math gamification LMS on traditional WordPress sites.",
	"author": "Damien Lawson",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"block",
		"accordion",
		"lms",
		"math",
		"gamification",
		"storefront"
	],
	"homepage": "https://github.com/damienresume/math-blazer#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/damienresume/math-blazer.git"
	},
	"bugs": {
		"url": "https://github.com/damienresume/math-blazer/issues"
	},
	"engines": {
		"node": "^24.15.0 || >=26.0.0"
	},
	"files": [
		"build/",
		"data/",
		"math-blazer.php"
	],
	"private": true,
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/wordpress__block-editor": "^15.0.7",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/interactivity": "^7.0.0",
		"@wordpress/scripts": "^36.1.0",
		"@wordpress/stylelint-config": "^26.1.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"scripts": {
		"build": "wp-scripts build --experimental-modules --blocks-manifest",
		"start": "wp-scripts start --experimental-modules --blocks-manifest",
		"typecheck": "tsc --noEmit",
		"lint": "npm run typecheck && npm run lint:js && npm run lint:css && npm run lint:pkg-json",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\" --allow-empty-input",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"lint:php": "composer run lint",
		"test": "wp-scripts test-unit-js --passWithNoTests",
		"check-engines": "wp-scripts check-engines",
		"plugin-zip": "npm run build && wp-scripts plugin-zip"
	}
}
