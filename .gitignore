# Dependencies that are installed by npm and Composer.
node_modules/
vendor/

# Files that the build creates. Run `npm run build` to create them.
build/
coverage/
*.zip

# Local settings. Copy .env.example to .env and change the values there. The .env file
# holds passwords and port choices for one computer, so it must never be committed. The
# rules also cover variants such as .env.local. The example file is the only exception.
.env
.env.*
!.env.example

# The docs folder holds personal review notes for the project owner. It is not part of
# the repository.
docs/

# Logs and editor or operating system files.
*.log
.DS_Store
.idea/
.vscode/
